# The worker needs FFmpeg on disk for video assembly, which is the main reason
# it cannot run as a serverless function.
FROM node:22-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# The worker imports the site's lib/content adapters, so both are copied and
# the worker runs from the repo root.
COPY worker/package.json worker/package-lock.json* ./worker/
RUN cd worker && npm install --omit=dev

COPY worker ./worker
COPY lib ./lib
COPY tsconfig.json ./

WORKDIR /app/worker
CMD ["npm", "start"]
